# Terraform working directories
**/.terraform/*

# State files (state lives in the S3 backend, never in git)
*.tfstate
*.tfstate.*

# Plan files
*.tfplan
tfplan

# Variable files can hold secrets; only the committed example is allowed
*.tfvars
*.tfvars.json
!example.tfvars

# Local backend config copied from backend.tf.example
backend.tf
*.backend.hcl

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config and local env
.terraformrc
terraform.rc
.env

# Lock files: committed for root stacks, not for reusable child modules
module/**/.terraform.lock.hcl

# Scanner output
results.sarif
